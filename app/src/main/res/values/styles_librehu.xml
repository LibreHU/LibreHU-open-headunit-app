<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LibreHU fork: the launcher accent over AppTheme (LibreHuTheme applies one on every activity and dialog theme). -->
    <style name="ThemeOverlay.LibreHU.Blue" parent="">
        <item name="librehuAccent">@color/librehu_accent_blue</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Teal" parent="">
        <item name="librehuAccent">@color/librehu_accent_teal</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Green" parent="">
        <item name="librehuAccent">@color/librehu_accent_green</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Yellow" parent="">
        <item name="librehuAccent">@color/librehu_accent_yellow</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Orange" parent="">
        <item name="librehuAccent">@color/librehu_accent_orange</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Red" parent="">
        <item name="librehuAccent">@color/librehu_accent_red</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Pink" parent="">
        <item name="librehuAccent">@color/librehu_accent_pink</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <style name="ThemeOverlay.LibreHU.Purple" parent="">
        <item name="librehuAccent">@color/librehu_accent_purple</item>
        <item name="librehuOnAccent">@color/librehu_on_accent</item>
    </style>
    <!-- Segment display font chosen in LibreHU Launcher (LibreHU Seg14, DSEG14, SIL OFL 1.1), over the accent. -->
    <style name="ThemeOverlay.LibreHU.Segment" parent="">
        <item name="android:fontFamily">@font/librehu_seg14</item>
        <item name="fontFamily">@font/librehu_seg14</item>
    </style>
    <!-- LibreHU Launcher's factory style (Modularer Infotainment-Baukasten): Source Sans 3, square corners
         (no window background here: the overlay also goes on the translucent activities). -->
    <style name="ThemeOverlay.LibreHU.Factory" parent="">
        <item name="android:fontFamily">@font/source_sans3</item>
        <item name="fontFamily">@font/source_sans3</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.LibreHU.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LibreHU.Square</item>
    </style>
    <!-- LibreHU Launcher's ambient style (LHU-Link): light text, square corners. -->
    <style name="ThemeOverlay.LibreHU.Ambient" parent="ThemeOverlay.LibreHU.Factory">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
    </style>
    <style name="ShapeAppearance.LibreHU.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
</resources>
